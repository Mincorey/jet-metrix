{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/system/auto-close-shift",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "templates/**"
    },
    "api/test.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/test", "destination": "/api/test" },
    { "source": "/api/(.+)", "destination": "/api/[...path]" },
    { "source": "/((?!api/|node_modules/|src/|@vite/|@react-refresh|manifest\\.json|logo\\.png|icon\\.png).*)", "destination": "/index.html" }
  ]
}
